{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "AI Agent Action v2",
  "type": "object",
  "required": ["proto", "kind", "seq", "action_id", "payload"],
  "properties": {
    "proto": { "type": "string", "const": "1" },
    "kind": { "type": "string", "const": "action" },
    "seq": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "number" },
    "action_id": { "type": "string", "minLength": 1 },
    "deadline_ms": { "type": "integer", "minimum": 0 },

    "payload": {
      "type": "object",
      "properties": {
        "look": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "yaw_delta": { "type": "number" },
            "pitch_delta": { "type": "number" },
            "turn_speed": { "type": "number", "minimum": 0 }
          },
          "required": ["yaw_delta", "pitch_delta"]
        },

        "move": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "forward": { "type": "number" },
            "strafe": { "type": "number" },

            "jump": { "type": "boolean" },
            "sprint": { "type": "boolean" },
            "sneak": { "type": "boolean" }
          },
          "required": ["forward", "strafe"]
        },

        "attack": { "type": "boolean" },
        "use": { "type": "boolean" },
        "place": { "type": "boolean" },

        "select_slot": { "type": "integer", "minimum": 0, "maximum": 8 }
      },
      "additionalProperties": false
    }
  },

  "anyOf": [
    {
      "required": ["payload"],
      "properties": {
        "payload": {
          "anyOf": [
            { "required": ["look"] },
            { "required": ["move"] },
            { "required": ["attack"] },
            { "required": ["use"] },
            { "required": ["place"] },
            { "required": ["select_slot"] }
          ]
        }
      }
    }
  ]
}