{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Minecraft Observation v1",
  "type": "object",
  "required": ["proto", "kind", "seq", "timestamp", "payload"],
  "properties": {
    "proto": { "type": "string", "enum": ["1"] },
    "kind": { "type": "string", "enum": ["observation"] },
    "seq": { "type": "number" },
    "timestamp": { "type": "number" },

    "payload": {
      "type": "object",
      "required": ["pose", "rays", "front_clear", "world", "inventory", "collision"],
      "properties": {
        "pose": {
          "type": "object",
          "required": ["x", "y", "z", "yaw", "pitch"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" },
            "yaw": { "type": "number" },
            "pitch": { "type": "number" }
          }
        },

        "rays": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hit", "dist", "angle_deg"],
            "properties": {
              "hit": { "type": "boolean" },
              "dist": { "type": "number" },
              "angle_deg": { "type": "number" }
            }
          }
        },

        "front_clear": { "type": "boolean" },

        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "dist", "los"],
            "properties": {
              "id": { "type": "number" },
              "type": { "type": "string" },
              "dist": { "type": "number" },
              "los": { "type": "boolean" }
            }
          }
        },

        "world": {
          "type": "object",
          "required": ["time_of_day", "weather", "biome"],
          "properties": {
            "time_of_day": { "type": "number" },
            "weather": { "type": "string" },
            "biome": { "type": "string" }
          }
        },

        "inventory": {
          "type": "object",
          "required": ["selected_slot", "hotbar"],
          "properties": {
            "selected_slot": { "type": "number" },
            "hotbar": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "count"],
                "properties": {
                  "id": { "type": "string" },
                  "count": { "type": "number" }
                }
              }
            }
          }
        },

        "collision": {
          "type": "object",
          "required": ["is_grounded", "is_colliding", "no_progress"],
          "properties": {
            "is_grounded": { "type": "boolean" },
            "is_colliding": { "type": "boolean" },
            "no_progress": { "type": "boolean" }
          }
        }
      }
    }
  }
}
